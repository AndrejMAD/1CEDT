Функция ОбновитьИлиСоздать(Продавец, ДанныеAPIЗаказ)
	
	Объект = Неопределено;
	Ссылка = НайтиПоРеквизиту("ИдЗаказа", ДанныеAPIЗаказ.ИдЗаказа);
	
	Если Ссылка = Неопределено ИЛИ Ссылка.Пустая() Тогда
		Объект = СоздатьДокумент();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Объект.Продавец = Продавец;
	ЗаполнитьИзДанныхAPI(Объект, ДанныеAPIЗаказ);
	
	Объект.Записать();
	Возврат Объект;
	
КонецФункции

Процедура ЗаполнитьИзДанныхAPI(Объект, ДанныеAPIЗаказ)
	
	Объект.Дата = ДанныеAPIЗаказ.Дата;
	Объект.Отменен = ДанныеAPIЗаказ.Отменен;
	Объект.ДатаОтмены = ДанныеAPIЗаказ.ДатаОтмены;
	Объект.ДатаОбновления = ДанныеAPIЗаказ.ДатаОбновления;
	Объект.КарточкаТовара = Справочники.КарточкиТоваров.НайтиПоРеквизиту("АртикулWB", ДанныеAPIЗаказ.АртикулWB, , Объект.Продавец);
	Объект.Размер = Справочники.РазмерыКарточекТоваров.НайтиПоРеквизиту("Размер", ДанныеAPIЗаказ.Размер, , Объект.КарточкаТовара);
	Объект.Поставка = Документы.Поставки.НайтиПоИдПоставки(ДанныеAPIЗаказ.ИдПоставки);
	Объект.СкладОтгрузки = Справочники.СкладыWB.НайтиПоНаименованию(ДанныеAPIЗаказ.СкладОтгрузки, Истина);
	Объект.ТипСклада = Перечисления.ТипыСкладов.ПолучитьПоНаименованию(ДанныеAPIЗаказ.ТипСклада);
	Объект.Страна = Справочники.Страны.ПолучитьПоНаименованию(ДанныеAPIЗаказ.Страна);
	Объект.Округ = Справочники.Округа.ПолучитьПоНаименованию(ДанныеAPIЗаказ.Округ);
	Объект.Регион = Справочники.Регионы.ПолучитьПоНаименованию(ДанныеAPIЗаказ.Регион);
	Объект.ЭтоДоговорПоставки = ДанныеAPIЗаказ.ЭтоДоговорПоставки;
	Объект.ЭтоДоговорРеализации = ДанныеAPIЗаказ.ЭтоДоговорРеализации;
	Объект.ЦенаБезСкидок = ДанныеAPIЗаказ.ЦенаБезСкидок;
	Объект.СкидкаПродавцаПроцент = ДанныеAPIЗаказ.СкидкаПродавцаПроцент;
	Объект.СкидкаWBПроцент = ДанныеAPIЗаказ.СкидкаWBПроцент;
	Объект.ЦенаСоСкидками = ДанныеAPIЗаказ.ЦенаСоСкидками;
	Объект.ЦенаСоСкидкойПродавца = ДанныеAPIЗаказ.ЦенаСоСкидкойПродавца;
	Объект.ИДСтикера = ДанныеAPIЗаказ.ИДСтикера;
	Объект.ИДКорзиныПокупателя = ДанныеAPIЗаказ.ИДКорзиныПокупателя;
	Объект.ИДЗаказа = ДанныеAPIЗаказ.ИДЗаказа;
	
КонецПроцедуры

Функция ПолучитьНачалоПериодаЗагрузки(Продавец)
	
	ДатаПоследнегоДокумента = ВыбратьДатуПоследнегоДокумента(Продавец);
	
	Если ДатаПоследнегоДокумента <> Неопределено Тогда
		Возврат ДатаПоследнегоДокумента;
	КонецЕсли;
	
	Возврат Справочники.Продавцы.ПолучитьДатуРегистрации(Продавец);

КонецФункции

