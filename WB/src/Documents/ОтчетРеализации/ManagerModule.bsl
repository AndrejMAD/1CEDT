#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьВсе() Экспорт
	
	Продавцы = Справочники.Продавцы.ВыбратьВсехПродавцов();
	
	Для Каждого Продавец Из Продавцы Цикл
		ЗагрузитьВсеПоПродавцу(Продавец);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьВсеПоПродавцу(Продавец) Экспорт
	
	ЗагрузитьСписокПоПродавцу(Продавец);
	ЗагрузитьДетализациюПоПрадавцу(Продавец);
	
КонецПроцедуры

Процедура ЗагрузитьСписокПоПродавцу(Продавец) Экспорт
	
	НачалоПериода = ПолучитьНачалоПериодаЗагрузки(Продавец);
	Токен = Справочники.Продавцы.ПолучитьТокен(Продавец);
	
	ПроверкаЗначенийКлиентСервер.ПроверитьЗначениеЗаполнено(Токен, Тип("Строка"));
	ПроверкаЗначенийКлиентСервер.ПроверитьЗначениеЗаполнено(Продавец, Тип("СправочникСсылка.Продавцы"));
	
	ДанныеAPI = ОтчетыРеализацииAPI.ПолучитьВсеЕжедневныеОтчетыРеализации(Токен, НачалоПериода);
	
	Если ДанныеAPI = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементAPI Из ДанныеAPI Цикл
		ОбновитьИлиСоздать(ЭлементAPI, Продавец);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДетализациюПоПрадавцу(Продавец) Экспорт
	
	Токен = Справочники.Продавцы.ПолучитьТокен(Продавец);
	ДокументыБезДетализации = ВыбратьБезЗагруженнойДетализации(Продавец);
	
	Для Каждого Док Из ДокументыБезДетализации Цикл
		
		ДокОбъект = Док.ПолучитьОбъект();		
		ДанныеAPI = ОтчетыРеализацииAPI.ПолучитьВсюДетализациюОтчетаРеализации(Токен, ДокОбъект.ИдОтчета);

		ЗаполнитьДетализациюИзДанныхAPI(ДокОбъект, ДанныеAPI);
		
		ДокОбъект.Записать();
		
		ВызватьПаузу(60000);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерезаполнитьДетализациюВДокументах(Документы) Экспорт
	
	Если Документы = Неопределено Тогда
		Возврат
	КонецЕсли;

	Для Каждого Документ Из Документы Цикл
		
		ДокументОбъект = Документ.ПолучитьОбъект();
		
		Если ДокументОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Стр Из ДокументОбъект.Детализация Цикл
			ЗаполнитьСтрокуДетализации(Стр, ДокументОбъект);
		КонецЦикла;
		
		ДокументОбъект.Записать();
		
	КонецЦикла;
КонецПроцедуры

