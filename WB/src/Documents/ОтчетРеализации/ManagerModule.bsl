Процедура ЗаполнитьСтрокуДетализации(Стр, Объект)
	
	Стр.ГруппаСтатьи = Справочники.СтатьиWB.ПолучитьГруппуПоНаименование(Стр.ОбоснованиеДляОплаты);
	Стр.Статья = Справочники.СтатьиWB.ПолучитьЭлементПоНаименование(Стр.ВидыЛогистикиШтрафов, Стр.ГруппаСтатьи);
	
	Если ЗначениеЗаполнено(Стр.АртикулWB) Тогда
		Стр.КарточкаТовара = Справочники.КарточкиТоваров.НайтиПоРеквизиту("АртикулWB", Стр.АртикулWB, , Объект.Продавец);
	Иначе
		Стр.КарточкаТовара = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.КарточкаТовара) И ЗначениеЗаполнено(Стр.ИдРазмера) Тогда
		Стр.Размер = Справочники.РазмерыКарточекТоваров.НайтиПоРеквизиту("Размер", Стр.ИдРазмера, , Стр.КарточкаТовара);
	Иначе
		Стр.Размер = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.НаименованиеСклада) Тогда
		Стр.Склад = Справочники.СкладыWB.НайтиПоНаименованию(Стр.НаименованиеСклада, Истина);
	Иначе
		Стр.Склад = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.ИдПоставки) Тогда
		Стр.Поставка = Документы.Поставки.НайтиПоИдПоставки(Стр.ИдПоставки);
	Иначе
		Стр.Поставка = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр.ИдЗаказа) Тогда
		Стр.Заказ = Документы.ЗаказыПокупателей.ПолучитьПоДетализацииОтчетаРеализации(Стр, Объект.Ссылка, Объект.Продавец);
	Иначе
		Стр.Заказ = Неопределено;
	КонецЕсли;
	
	Если Стр.ПроцентКВВ > 0 Тогда
		Стр.СуммаКВВ = Стр.ЦенаРозничнаяСоСкидкой * Стр.ПроцентКВВ / 100;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьНачалоПериодаЗагрузки(Продавец)
	
	ДатаПоследнегоДокумента = ВыбратьДатуПоследнегоДокумента(Продавец);
	
	Если ДатаПоследнегоДокумента <> Неопределено Тогда
		Возврат ДатаПоследнегоДокумента;
	КонецЕсли;
	
	Возврат Справочники.Продавцы.ПолучитьДатуРегистрации(Продавец);

КонецФункции

Функция ВыбратьДатуПоследнегоДокумента(Продавец)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОтчетРеализации.Дата КАК Дата
	|ИЗ
	|	Документ.ОтчетРеализации КАК ОтчетРеализации
	|ГДЕ
	|	ОтчетРеализации.Продавец = &Продавец
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Продавец", Продавец);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Дата;
	
КонецФункции

