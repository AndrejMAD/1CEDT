
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ВыбратьПоСтатье(Статья) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СтатьиДРВЗаказах.Статья КАК Статья,
		|	СтатьиДРВЗаказах.ЗаказОтменен КАК ЗаказОтменен
		|ИЗ
		|	РегистрСведений.СтатьиДРВЗаказах КАК СтатьиДРВЗаказах
		|ГДЕ
		|	СтатьиДРВЗаказах.Статья = &Статья";
	
	Запрос.УстановитьПараметр("Статья", Статья);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат Новый Структура("Статья, ЗаказОтменен", ВыборкаДетальныеЗаписи.Статья, ВыборкаДетальныеЗаписи.ЗаказОтменен);
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

